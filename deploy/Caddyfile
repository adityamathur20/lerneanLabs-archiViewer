{
	email {$ACME_EMAIL}
	# Certificate state lives in a named volume (compose). Losing it re-requests
	# certificates and Let's Encrypt's rate limit then locks TLS out for a week,
	# so first-run experimentation should point at staging:
	#   ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
	# Unset means production. Staging certs are untrusted by browsers BY DESIGN —
	# that is the signal you are still on staging, not a failure.
	# Bare, NOT {$ACME_CA:default}: Caddy's own default syntax only applies when
	# the variable is UNSET, and compose always sets it. An empty value reached
	# this line as `acme_ca` with no argument — a fatal parse error that took
	# the whole proxy down. compose supplies the production URL with `:-`.
	acme_ca {$ACME_CA}
	# Do not advertise the server or its version.
	servers {
		# Slow-request exhaustion is open by default.
		timeouts {
			read_body 30s
			read_header 10s
			write 120s
			idle 2m
		}
	}
}

# Applied to every site below. Kept in one snippet so a new hostname cannot
# quietly ship without them.
(hardened) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
		-Server
	}
}

# --- the viewer --------------------------------------------------------------
planto3d.in {
	import hardened

	# The page holds an API key in localStorage, so XSS here is credential
	# theft. 'wasm-unsafe-eval' is required by web-ifc; 'unsafe-inline' for
	# style only, because index.html carries a <style> block and style
	# attributes. No 'unsafe-eval', no'unsafe-inline' for script, and
	# connect-src is limited to our own API and object store.
	header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.planto3d.in https://s3.planto3d.in; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"

	root * /srv/viewer
	encode zstd gzip

	# Vite hashes every asset name, so these are immutable. Without this the
	# box re-compresses ~14 MB per cold visit, and CPU is the one resource
	# spec §11 says is scarce.
	@assets path /assets/* /web-ifc/* /cad/assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Dotfiles are never content. Without this a stray .env or .git copied into
	# the web root would be served.
	#
	# Inside a `route` so this runs BEFORE try_files. Caddy sorts directives by
	# its own order otherwise, and try_files rewrote a non-existent dotfile to
	# /index.html — which then no longer matched /\. and returned 200 with the
	# page body. The existing-file case was still refused, so nothing leaked,
	# but the post-deploy scan's own check failed on a correct deploy.
	# The Drawing view lives at /cad/. Its asset URLs are absolute, but a
	# trailing slash keeps relative links and the address bar honest.
	redir /cad /cad/ 308

	route {
		@hidden path_regexp /\.
		respond @hidden 404
		# {path}/ so /cad (no slash) reaches the Drawing view's
		# /cad/index.html instead of falling through to the 3D view.
		try_files {path} {path}/ /index.html
		file_server
	}
}

www.planto3d.in {
	import hardened
	redir https://planto3d.in{uri} permanent
}

# Held defensively, not a second deployment (spec §3.1). {uri} is this
# request's own path and query, so this cannot redirect off-domain.
planto3d.si {
	import hardened
	redir https://planto3d.in{uri} permanent
}

# --- the API ----------------------------------------------------------------
api.planto3d.in {
	import hardened

	# FastAPI reads the whole body BEFORE dependencies run, so the 401 is
	# decided after the bytes are already in memory: an anonymous POST with a
	# multi-GB body would OOM a box that is also running Postgres, Redis,
	# Garage and a conversion. Uploads do not come through here — they go
	# straight to the object store via a presigned PUT.
	request_body {
		max_size 64KB
	}
	# An API response is never a document; if one is ever reflected to a
	# browser it must not execute.
	header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
	reverse_proxy api:8000
}

# --- object storage ---------------------------------------------------------
# Public because presigned URLs sign the host, and the browser must reach the
# same host the signature was made for (spec §4.3). Garage itself publishes no
# port; this is the only way in, and its access keys remain the authorization
# boundary.
s3.planto3d.in {
	import hardened

	# fetch() follows the API's 302 here and the FINAL response is the one whose
	# CORS headers are checked. It must be `*`, not the viewer origin: the first
	# hop (planto3d.in -> api.planto3d.in) is already cross-origin, so the Fetch
	# spec marks the chain tainted and this request arrives with `Origin: null`.
	# A header of https://planto3d.in then fails the check and every download
	# breaks — verified in Chrome.
	#
	# `*` is safe here precisely because the presigned signature IS the
	# credential: credentials mode is never `include`, no cookie is in play, and
	# a wildcard grants nothing that holding the URL did not already grant.
	# NOTE: the allow-origin header is set via reverse_proxy's header_down
	# below, NOT here. Garage emits its own `Access-Control-Allow-Origin: *`,
	# and a `header` directive ADDS to that rather than replacing it — giving
	# two identical values, which browsers reject outright ("contains multiple
	# values"). Observed live: curl was happy, a browser would not have been.
	# header_down replaces, because it runs after the proxy writes.

	# The browser's presigned PUT needs a preflight ANSWERED, not just a
	# response header: a GET with no custom headers is a simple request, but
	# PUT never is, so the browser sends OPTIONS first and refuses to upload if
	# nothing replies. Garage itself does not answer it, so Caddy does —
	# otherwise the upload form fails with an unexplained CORS error while
	# `curl` uploads fine.
	@preflight method OPTIONS
	handle @preflight {
		header Access-Control-Allow-Origin "*"
		header Access-Control-Allow-Methods "GET, HEAD, PUT"
		header Access-Control-Allow-Headers "content-type, x-amz-content-sha256, x-amz-date, x-amz-acl"
		header Access-Control-Max-Age "600"
		respond 204
	}
	header Vary "Origin"
	# Artifacts are data. Never let one execute as a document.
	header Content-Security-Policy "default-src 'none'"
	header X-Content-Type-Options "nosniff"

	# Only the S3 data path. Garage's admin API (:3903) is NOT proxied, and
	# bucket-level operations are not reachable through a single-bucket path.
	reverse_proxy garage:3900 {
		# header_down REPLACES, so Garage's own copy does not survive
		# alongside ours. `header` would have appended instead.
		header_down Access-Control-Allow-Origin "*"
		header_down Access-Control-Expose-Headers "ETag, Content-Length"
	}
}
