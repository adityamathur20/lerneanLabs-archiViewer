{
  "name": "archiagent-viewer",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "dev:cad": "npm --prefix cad run dev",
    "build": "vite build && npm --prefix cad run build",
    "postinstall": "npm --prefix cad ci",
    "preview": "vite preview",
    "test": "node --test 'tests/*.test.mjs'",
    "smoke": "node scripts/smoke.mjs",
    "shot": "node scripts/shot.mjs",
    "build:frag": "node scripts/build-frag.mjs",
    "csp": "node scripts/csp-check.mjs",
    "security": "node scripts/security-scan.mjs",
    "check:cad": "node scripts/cad-check.mjs"
  },
  "description": "Renders archiAgent's authored IFC in the browser with @thatopen/fragments.",
  "dependencies": {
    "@thatopen/fragments": "3.4.7",
    "three": "^0.182.0",
    "vite": "^6.4.3",
    "web-ifc": "0.0.77"
  },
  "type": "module",
  "private": true,
  "devDependencies": {
    "puppeteer-core": "^24.43.1"
  }
}
