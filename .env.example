# Copy to .env on the VPS, fill in, chmod 600. Never commit the result.

# --- generated on the box: openssl rand -hex 32 ---
# GARAGE_RPC_SECRET must be EXACTLY 32 bytes of hex (64 characters). Garage
# refuses to start otherwise ("Invalid RPC secret key"), and because it exits
# rather than degrades, the whole stack crash-loops. -hex 32, not -hex 24.
POSTGRES_PASSWORD=
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=

# --- printed by deploy/provision-garage.sh ---
ARCHIAGENT_SERVICE_S3_ACCESS_KEY=
ARCHIAGENT_SERVICE_S3_SECRET_KEY=

# --- fixed for this deployment ---
# MUST be the public host: presigned URLs sign it and the browser must reach
# the same name (spec §4.3). Never http://garage:3900.
ARCHIAGENT_SERVICE_S3_ENDPOINT=https://s3.planto3d.in
ARCHIAGENT_SERVICE_S3_BUCKET=archiagent
ARCHIAGENT_SERVICE_CORS_ORIGINS=["https://planto3d.in"]
ACME_EMAIL=lerneantechlabs@gmail.com
VIEWER_ORIGIN=https://planto3d.in

# Point at Let's Encrypt STAGING while you are still getting DNS and the
# compose file right. Staging certificates are untrusted by browsers by
# design; that is the signal, not a failure. Production has a rate limit that
# locks you out of TLS for a week if you burn it on failed attempts.
#   ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
# Leave EMPTY for production: compose substitutes the production URL.
ACME_CA=

# --- yours ---
ANTHROPIC_API_KEY=
